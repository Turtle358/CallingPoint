<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Travel options"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Step-free access"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Route preference"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/radioGroupPreference"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radioFastest"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Fastest routes"
                android:textColor="@color/text_primary"
                android:textSize="16sp"/>

            <RadioButton
                android:id="@+id/radioChanges"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Fewest changes"
                android:textColor="@color/text_primary"
                android:textSize="16sp"/>

            <RadioButton
                android:id="@+id/radioWalking"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Least walking"
                android:textColor="@color/text_primary"
                android:textSize="16sp"/>
        </RadioGroup>
    </LinearLayout>
</androidx.cardview.widget.CardView>