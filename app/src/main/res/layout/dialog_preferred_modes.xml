<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preferred modes"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modes you'd like prioritised in your results"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchTrain"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Train"
            android:textColor="@color/text_primary"
            android:textSize="16sp"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchTram"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Tram"
            android:textColor="@color/text_primary"
            android:textSize="16sp"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchTube"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Underground"
            android:textColor="@color/text_primary"
            android:textSize="16sp"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchBus"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Bus"
            android:textColor="@color/text_primary"
            android:textSize="16sp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>