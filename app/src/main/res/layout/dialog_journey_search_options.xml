<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:background="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="22dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Journey options"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="23sp"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Journey preference"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/radioGroupPreference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radioFastest"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Fastest route"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radioChanges"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Fewest changes"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radioWalking"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Least walking"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </RadioGroup>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchAccessibility"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="4dp"
                android:text="Accessible routes"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fallback_accessibility_help"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/text_secondary"
                android:alpha="0.2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Travel by"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="6dp"
                android:text="Walking is included with every selection. Transitous allows up to 60 minutes of walking at each end. Leave all off to include every transport mode."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchTrain"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Train"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchTube"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Underground"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchBus"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Bus"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchTram"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Tram"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDoneJourneyOptions"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="Show journeys"
                android:textSize="16sp"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/brand_primary" />
        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
