<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="54dp">

    <View
        android:id="@+id/skelLineTop"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="#333333"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/skelDot"
        app:layout_constraintStart_toStartOf="@id/skelDot"
        app:layout_constraintEnd_toEndOf="@id/skelDot" />

    <View
        android:id="@+id/skelDot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:background="#333333"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:ignore="MissingConstraints" />

    <View
        android:id="@+id/skelLineBottom"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="#333333"
        app:layout_constraintTop_toBottomOf="@id/skelDot"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/skelDot"
        app:layout_constraintEnd_toEndOf="@id/skelDot" />

    <View
        android:id="@+id/skelName"
        android:layout_width="160dp"
        android:layout_height="16dp"
        android:layout_marginStart="16dp"
        android:background="#222222"
        app:layout_constraintTop_toTopOf="@id/skelDot"
        app:layout_constraintBottom_toBottomOf="@id/skelDot"
        app:layout_constraintStart_toEndOf="@id/skelDot"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>