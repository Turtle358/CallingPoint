<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:paddingHorizontal="16dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/timeline_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="24dp" />

    <View
        android:id="@+id/lineTop"
        android:layout_width="4dp"
        android:layout_height="0dp"
        android:background="#444444"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/dotStation"
        app:layout_constraintStart_toStartOf="@id/timeline_center"
        app:layout_constraintEnd_toEndOf="@id/timeline_center" />

    <View
        android:id="@+id/dotStation"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/timeline_center"
        app:layout_constraintEnd_toEndOf="@id/timeline_center" />

    <View
        android:id="@+id/lineBottom"
        android:layout_width="4dp"
        android:layout_height="0dp"
        android:background="#444444"
        app:layout_constraintTop_toBottomOf="@id/dotStation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/timeline_center"
        app:layout_constraintEnd_toEndOf="@id/timeline_center" />

    <TextView
        android:id="@+id/tvStationName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:text=""
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvPlatform"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@id/timeline_center"
        app:layout_constraintEnd_toStartOf="@id/tvSchTime" />

    <TextView
        android:id="@+id/tvPlatform"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:text="Platform 1"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvStationName"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/timeline_center" />

    <TextView
        android:id="@+id/tvSchTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="11:30"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textAlignment="viewEnd"
        app:layout_constraintTop_toTopOf="@id/dotStation"
        app:layout_constraintBottom_toBottomOf="@id/dotStation"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvLiveTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="On time"
        android:textColor="#00875A"
        android:textSize="12sp"
        android:textAlignment="viewEnd"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvSchTime"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/iconTrainTop"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_train"
        android:background="@drawable/bg_pill_base"
        android:backgroundTint="?android:attr/colorBackground"
        android:padding="2dp"
        android:visibility="gone"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/dotStation"
        app:layout_constraintStart_toStartOf="@id/timeline_center"
        app:layout_constraintEnd_toEndOf="@id/timeline_center" />

    <ImageView
        android:id="@+id/iconTrainBottom"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_train"
        android:background="@drawable/bg_pill_base"
        android:backgroundTint="?android:attr/colorBackground"
        android:padding="2dp"
        android:visibility="gone"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/dotStation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/timeline_center"
        app:layout_constraintEnd_toEndOf="@id/timeline_center" />

    <ImageView
        android:id="@+id/iconTrainAt"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_train"
        android:background="@drawable/bg_pill_base"
        android:backgroundTint="?android:attr/colorBackground"
        android:padding="2dp"
        android:visibility="gone"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="@id/dotStation"
        app:layout_constraintBottom_toBottomOf="@id/dotStation"
        app:layout_constraintStart_toStartOf="@id/timeline_center"
        app:layout_constraintEnd_toEndOf="@id/timeline_center" />

</androidx.constraintlayout.widget.ConstraintLayout>