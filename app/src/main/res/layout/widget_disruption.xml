<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_rounded"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <RelativeLayout
        android:id="@+id/titleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/titleLine1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/refreshFrame"
            android:layout_marginEnd="8dp"
            android:text="Status"
            android:textColor="#111111"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />

        <FrameLayout
            android:id="@+id/refreshFrame"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true">

            <ImageView
                android:id="@+id/widgetRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Refresh"
                android:src="@android:drawable/ic_popup_sync"
                android:tint="#111111" />

            <ProgressBar
                android:id="@+id/widgetProgressDark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:indeterminateTint="#111111" />

            <ProgressBar
                android:id="@+id/widgetProgressLight"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:indeterminateTint="#FFFFFF" />
        </FrameLayout>

        <TextView
            android:id="@+id/titleLine2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/titleLine1"
            android:layout_alignParentStart="true"
            android:text="Disruption"
            android:textColor="#111111"
            android:textSize="18sp"
            android:letterSpacing="-0.01" />

    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widgetLogo"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_national_rail"
            android:tint="#111111" />

        <TextView
            android:id="@+id/widgetTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="11:20"
            android:textColor="#111111"
            android:textSize="12sp"
            android:includeFontPadding="false" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/layoutPills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="6dp"
            tools:visibility="visible">

            <TextView
                android:id="@+id/badge1_text"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:minWidth="34dp"
                android:layout_marginEnd="4dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:background="@drawable/bg_pill_base"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:includeFontPadding="false"
                tools:visibility="visible"
                tools:text="EMR"
                tools:backgroundTint="#603950" />

            <TextView
                android:id="@+id/badge2_text"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:minWidth="34dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:background="@drawable/bg_pill_base"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:includeFontPadding="false"
                tools:visibility="visible"
                tools:text="SN"
                tools:backgroundTint="#003D2E" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutBars"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView android:id="@+id/bar1" android:layout_width="10dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:src="@drawable/bg_bar_base" />
            <ImageView android:id="@+id/bar2" android:layout_width="10dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:src="@drawable/bg_bar_base" />
            <ImageView android:id="@+id/bar3" android:layout_width="10dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:src="@drawable/bg_bar_base" />
            <ImageView android:id="@+id/bar4" android:layout_width="10dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:src="@drawable/bg_bar_base" />
            <ImageView android:id="@+id/bar5" android:layout_width="10dp" android:layout_height="match_parent" android:src="@drawable/bg_bar_base" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iconAlert"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_alert_diamond"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>