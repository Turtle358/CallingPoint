<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_screen"
    android:fitsSystemWindows="true">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:letterSpacing="-0.02"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/headerApiKeys"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp"
                        android:gravity="center_vertical"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="API Credentials"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/iconApiKeysToggle"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/contentApiKeys"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingBottom="20dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Disruptions API Key"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp">

                            <EditText
                                android:id="@+id/etCustomerKey"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Paste Disruptions Key here..."
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_secondary"
                                android:inputType="textPassword"
                                android:padding="16dp"
                                android:paddingEnd="48dp"
                                android:background="@drawable/bg_edit_text" />

                            <ImageButton
                                android:id="@+id/btnTogglePassword"
                                android:layout_width="48dp"
                                android:layout_height="match_parent"
                                android:layout_alignTop="@id/etCustomerKey"
                                android:layout_alignBottom="@id/etCustomerKey"
                                android:layout_alignParentEnd="true"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_visibility_off"
                                app:tint="@color/text_secondary"
                                android:contentDescription="Toggle Visibility" />
                        </RelativeLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Live Departures (LDBWS) Key"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="24dp">

                            <EditText
                                android:id="@+id/etLdbwsKey"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Paste LDBWS Key here..."
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_secondary"
                                android:inputType="textPassword"
                                android:padding="16dp"
                                android:paddingEnd="48dp"
                                android:background="@drawable/bg_edit_text" />

                            <ImageButton
                                android:id="@+id/btnToggleLdbwsPassword"
                                android:layout_width="48dp"
                                android:layout_height="match_parent"
                                android:layout_alignTop="@id/etLdbwsKey"
                                android:layout_alignBottom="@id/etLdbwsKey"
                                android:layout_alignParentEnd="true"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_visibility_off"
                                app:tint="@color/text_secondary"
                                android:contentDescription="Toggle Visibility" />
                        </RelativeLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Live Arrivals API Key"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="24dp">

                            <EditText
                                android:id="@+id/etArrivalsKey"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Paste Arrivals Key here..."
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_secondary"
                                android:inputType="textPassword"
                                android:padding="16dp"
                                android:paddingEnd="48dp"
                                android:background="@drawable/bg_edit_text" />

                            <ImageButton
                                android:id="@+id/btnToggleArrivalsPassword"
                                android:layout_width="48dp"
                                android:layout_height="match_parent"
                                android:layout_alignTop="@id/etArrivalsKey"
                                android:layout_alignBottom="@id/etArrivalsKey"
                                android:layout_alignParentEnd="true"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_visibility_off"
                                app:tint="@color/text_secondary"
                                android:contentDescription="Toggle Visibility" />
                        </RelativeLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Service Details API Key"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="24dp">

                            <EditText
                                android:id="@+id/etServiceDetailsKey"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Paste Service Details Key here..."
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_secondary"
                                android:inputType="textPassword"
                                android:padding="16dp"
                                android:paddingEnd="48dp"
                                android:background="@drawable/bg_edit_text" />

                            <ImageButton
                                android:id="@+id/btnToggleServiceDetailsPassword"
                                android:layout_width="48dp"
                                android:layout_height="match_parent"
                                android:layout_alignTop="@id/etServiceDetailsKey"
                                android:layout_alignBottom="@id/etServiceDetailsKey"
                                android:layout_alignParentEnd="true"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_visibility_off"
                                app:tint="@color/text_secondary"
                                android:contentDescription="Toggle Visibility" />
                        </RelativeLayout>

                        <Button
                            android:id="@+id/btnSaveSettings"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:text="Save Credentials"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/brand_primary"
                            android:textColor="#FFFFFF"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reference Data"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Update your local list of stations and train operators to ensure you have the latest available data."
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btnManualSync"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Check for Updates"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/brand_primary"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Appearance"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_theme_track"
                        android:padding="4dp">

                        <View
                            android:id="@+id/slidingPillTheme"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/selector_theme_tab" />

                        <RadioGroup
                            android:id="@+id/themeRadioGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/radioThemeAuto"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:button="@null"
                                android:gravity="center"
                                android:paddingVertical="10dp"
                                android:text="Auto"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <RadioButton
                                android:id="@+id/radioThemeLight"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:button="@null"
                                android:gravity="center"
                                android:paddingVertical="10dp"
                                android:text="Light"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <RadioButton
                                android:id="@+id/radioThemeDark"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:button="@null"
                                android:gravity="center"
                                android:paddingVertical="10dp"
                                android:text="Dark"
                                android:textColor="@color/selector_theme_text"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </RadioGroup>
                    </FrameLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tracked Operators"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Select which operators to display on your home screen widget. Changes are saved automatically."
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerTocsSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:paddingBottom="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>