<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.turtle358.callingpoint">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".CallingPointApp"
        android:icon="@mipmap/ic_launcher"
        android:label="Calling Point"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.callingpoint">

        <activity
            android:name="io.github.turtle358.callingpoint.ui.activities.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="io.github.turtle358.callingpoint.ui.activities.ServiceDetailsActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name="io.github.turtle358.callingpoint.ui.activities.TOCDetailActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name="io.github.turtle358.callingpoint.ui.activities.JourneyDetailsActivity"
            android:screenOrientation="portrait" />

        <receiver
            android:name="io.github.turtle358.callingpoint.widget.AppWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>